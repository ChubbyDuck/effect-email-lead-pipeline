            "patterns": [
              {
                "group": ["\\#Infrastructure/**", "\\#Entrypoints/**"],
                "message": "The core never imports Infrastructure or Entrypoints."
              },
              {
                "group": ["@tanstack/react-start", "@tanstack/react-start/**", "aws-lambda"],
                "message": "Only Entrypoints import a protocol library."
              },
              {
                "regex": "^\\.\\./\\.\\./",
                "message": "Import a different folder of the package with a # path, so that the layer rules can check it."
              },
              {
                "group": ["\\#Core/**", "!\\#Core/Shared/Domain/**"],
                "message": "The Domain of the shared kernel imports only itself."
              },
              {
                "group": ["@leads/**"],
                "message": "The Domain of the shared kernel imports only itself. Another package comes in only through the shared kernel."
              }
            ]
          }
        ]
      }
